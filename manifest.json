{
  "manifest_version": 3,
  "name": "History Keeper",
  "version": "1.0.0",
  "description": "Keeps a permanent, searchable local archive of your browsing history past Chrome's 90-day expiry.",
  "minimum_chrome_version": "116",
  "permissions": [
    "history",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "History Keeper",
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
